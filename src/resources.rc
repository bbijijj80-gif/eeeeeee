// Ресурсы Windows для minidb.exe: иконка приложения и сведения о версии.
#include <winver.h>
#include "resource.h"

IDI_MINIDB ICON "../assets/minidb.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "MiniDB Project"
            VALUE "FileDescription", "MiniDB - relational database engine"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "minidb"
            VALUE "OriginalFilename", "minidb.exe"
            VALUE "ProductName", "MiniDB"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
